# www -> apex (en adresse for indeksering)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.regweb\.no$ [NC]
RewriteRule ^(.*)$ https://regweb.no/$1 [R=301,L]

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Passordfiler skal aldri kunne leses over nett
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

# 2026-10-17: sikkerhetshoder (SEO-audit S8). HSTS uten includeSubDomains: sak.regweb.no m.fl. er egne tjenester.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
