#!/bin/bash
# Deploys branch "main" of this bare repo to the live web root (static site, no build step).
# Push from the Mac:  git push produksjon <local-branch>:main
# DRYRUN=1 /home/5/r/regweb/regweb-no-web.git/hooks/post-receive  -> shows what would change without touching www
set -e
GIT_DIR=/home/5/r/regweb/regweb-no-web.git
WWW=/home/5/r/regweb/www
EXCL=(--exclude=design-source --exclude=.claude --exclude=README.md --exclude=CNAME --exclude=.nojekyll --exclude=.gitignore --exclude=assets/img/original)
deploy() {
  local rev="$1" tmp
  tmp=$(mktemp -d /home/5/r/regweb/.deploy.XXXXXX)
  git --git-dir="$GIT_DIR" archive "$rev" | tar -x -C "$tmp"
  if [ -n "$DRYRUN" ]; then
    rsync -rlt --omit-dir-times --chmod=D755,F644 --delete --dry-run -i "${EXCL[@]}" "$tmp"/ "$WWW"/
  else
    rsync -rlt --omit-dir-times --chmod=D755,F644 --delete "${EXCL[@]}" "$tmp"/ "$WWW"/
    # brukerveiledning/.htaccess peker på lokal passordfil i repoet; bytt til passordfilen utenfor www på serveren
    if [ -f "$WWW/brukerveiledning/.htaccess" ]; then
      sed -i 's#/var/www/regweb-no-web/.htpasswd-brukerveiledning#/home/5/r/regweb/.htpasswd-regweb-brukerveiledning#' "$WWW/brukerveiledning/.htaccess"
    fi
    echo "Deployed $(git --git-dir="$GIT_DIR" rev-parse --short "$rev") to $WWW"
  fi
  rm -rf "$tmp"
}
if [ -n "$DRYRUN" ]; then deploy main; exit 0; fi
while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] && deploy "$new"
done
exit 0
